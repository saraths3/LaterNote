# ==============================================================================
# LaterNote Environment Configuration (.env.example)
# ==============================================================================

# SECURITY WARNING: Generate a strong, unpredictable key for production!
SECRET_KEY=django-insecure-laternote-change-me-in-production-vault-key-12345

# Set to False in production. Set to True only for local development.
DEBUG=False

# Comma-separated hostnames allowed to connect (include your Render domain)
ALLOWED_HOSTS=127.0.0.1,localhost,.onrender.com

# Comma-separated trusted origins for CSRF protection when submitting POST forms over HTTPS
CSRF_TRUSTED_ORIGINS=https://*.onrender.com,http://127.0.0.1,http://localhost

# Web server port (Render supplies this automatically)
PORT=8000
